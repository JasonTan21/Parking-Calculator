.DS_Store

# Runtime account/session/state data. These files can contain private user data.
/data/*
!/data/.htaccess
!/data/.gitkeep

# Runtime profile uploads. Keep the folder/security rule, not user pictures.
/uploads/*
!/uploads/.gitkeep
!/uploads/profile/
/uploads/profile/*
!/uploads/profile/.htaccess
!/uploads/profile/.gitkeep

# Local editor/system files
*.log
*.tmp
